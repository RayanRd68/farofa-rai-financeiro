# Supabase — valores PÚBLICOS (vão no bundle do navegador; a segurança é a RLS).
# Já têm um padrão embutido em lib/supabase/config.ts; estas env vars sobrescrevem.
NEXT_PUBLIC_SUPABASE_URL=https://dguqupwfjfnbdxyngbyb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# -----------------------------------------------------------------------------
# Integração com o CRM (opcional) — rota /api/ingest/venda
# -----------------------------------------------------------------------------
# Segredo compartilhado com o CRM. O MESMO valor precisa estar em
# `private.sync_config.ingest_secret` (Supabase) e em `FINANCE_INGEST_SECRET`
# no projeto do CRM. Sem esta env var a rota /api/ingest/venda responde 401.
# Gere com: openssl rand -base64 32
INGEST_SECRET=
